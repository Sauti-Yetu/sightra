{
  "name": "Sightra — Visual Assistance Companion",
  "short_name": "Sightra",
  "description": "AI-powered visual assistance for people with visual impairment. Understand surroundings, navigate safely, and connect with human help.",
  "start_url": "/dashboard/",
  "id": "/dashboard/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a1628",
  "theme_color": "#006875",
  "lang": "en",
  "categories": ["accessibility", "utilities", "navigation"],
  "icons": [
    { "src": "/static/icons/icon-72.png", "sizes": "72x72", "type": "image/png" },
    { "src": "/static/icons/icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/static/icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/static/icons/icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/static/icons/icon-152.png", "sizes": "152x152", "type": "image/png" },
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Start Camera",
      "short_name": "Vision",
      "description": "Open live vision assistance",
      "url": "/vision/",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Voice Assistant",
      "short_name": "Voice",
      "description": "Ask Sightra a question",
      "url": "/voice_assistant/",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Navigation",
      "short_name": "Navigate",
      "description": "Get navigation guidance",
      "url": "/live-map/",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Human Help",
      "short_name": "Help",
      "description": "Connect with a volunteer",
      "url": "/sightra-connect/",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
