[Unit]
Description=Sightra Pi camera client (navigation stream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi_client
ExecStart=/usr/bin/python3 /home/pi/pi_client/main.py
Restart=always
RestartSec=5

# URLs and options: prefer /home/pi/pi_client/.env (loaded by main.py via python-dotenv).
# Optional extra file for systemd-only variables:
EnvironmentFile=-/home/pi/pi_client/sightra.env

[Install]
WantedBy=multi-user.target
