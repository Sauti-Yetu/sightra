# Copy this file to .env and set your server URL(s).
# cp .env.example .env
#
# Single public HTTP origin (API + /media/). No :8000 — use Nginx on port 80.
SIGHTRA_PUBLIC_BASE=http://72.61.88.50
#
# Optional: override API URL only (default = PUBLIC_BASE + /api/navigation/stream/)
# SIGHTRA_API_URL=http://72.61.88.50/api/navigation/stream/
#
# Play server TTS (audio_url HTTP + optional audio_base64). Set 0 for local espeak only.
# SIGHTRA_USE_SERVER_AUDIO=1

SIGHTRA_DEVICE_ID=pi-zero-2w-01

# Optional — same as documented in PI_DEPLOYMENT.md
# SIGHTRA_TEXT_PROMPT=Describe obstacles ahead
# SIGHTRA_CAPTURE_DEVICE=plughw:1,0
# SIGHTRA_PLAYBACK_DEVICE=plughw:1,0
# SIGHTRA_VOSK_MODEL=/home/pi/vosk-model-small-en-us-0.15
