[Unit]
Description=Sightra Pi camera client (navigation stream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi_client
ExecStart=/usr/bin/python3 /home/pi/pi_client/main.py
Restart=always
RestartSec=5

# Optional: create /home/pi/pi_client/sightra.env with:
# SIGHTRA_API_URL=https://your-server.example.com/api/navigation/stream/
# SIGHTRA_DEVICE_ID=pi-zero-2w-01
EnvironmentFile=-/home/pi/pi_client/sightra.env

[Install]
WantedBy=multi-user.target
