# Copy this file to .env and set your server URL(s).
# cp .env.example .env
#
# Option A — full endpoint URL (recommended):
SIGHTRA_API_URL=https://your-server.example.com/api/navigation/stream/
#
# Option B — base URL only (path /api/navigation/stream/ is appended):
# SIGHTRA_BASE_URL=https://your-server.example.com
#
# If neither is set, defaults to http://127.0.0.1:8000/api/navigation/stream/
#
# TLS options:
# SIGHTRA_TLS_VERIFY=1
# If using a self-signed cert, either set VERIFY=0 (quick test) or provide CA cert path:
# SIGHTRA_TLS_CA_CERT=/home/pi/pi_client/certs/server.crt

SIGHTRA_DEVICE_ID=pi-zero-2w-01

# Optional — same as documented in PI_DEPLOYMENT.md
# SIGHTRA_TEXT_PROMPT=Describe obstacles ahead
# SIGHTRA_CAPTURE_DEVICE=plughw:1,0
# SIGHTRA_PLAYBACK_DEVICE=plughw:1,0
# SIGHTRA_VOSK_MODEL=/home/pi/vosk-model-small-en-us-0.15
